+                new_email=email,
+                add_note=add_note,
+                actor=get_cli_actor(),
+                today=today,
+            )
+        except sqlite3.Error as exc:
+            render_error("Database error", str(exc))
+            raise typer.Exit(code=5) from None
+    finally:
+        with contextlib.suppress(sqlite3.Error):
+            conn.close()
