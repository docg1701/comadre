+_UPDATE_CUSTOMER_NEITHER_HINT = (
+    'Provide --email NEW_EMAIL or --add-note "text" (or both).'
+)
+_UPDATE_CUSTOMER_NOTE_EMPTY_HINT = (
+    "Provide note text with content. Whitespace-only notes are rejected."
