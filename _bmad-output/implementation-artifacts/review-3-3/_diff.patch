+def _fetch_status(conn: sqlite3.Connection, key_id: str) -> str:
+    row = conn.execute(
+        "SELECT status FROM api_key WHERE id = ?", (key_id,)
+    ).fetchone()
+    assert row is not None
+    return str(row["status"])
