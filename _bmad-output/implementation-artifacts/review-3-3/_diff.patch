+    ) -> None:
+        """AC13 — INFO log is PII-free."""
+        from comadre.logging import get_logger
+
+        _seed_expired_portfolio(env["db_path"])
+        _freeze_today(monkeypatch, date(2026, 4, 6))
+        logger = get_logger("keys.cli")
