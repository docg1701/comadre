+            _seed_key(
+                conn,
+                customer_id=c_ana,
+                key_prefix="A_tie001",
+                key_hash="8" * 64,
+                paid_until="2026-04-20",
+            )
+        finally:
+            conn.close()
+        _freeze_today(monkeypatch, date(2026, 4, 18))
+        _clear_buffers()
+        result = runner.invoke(app, ["at-risk", "--window", "5d"])
