+# Story 2.3 PII-leak guard — any match in an INFO log line is a FR37 / NFR15 regression.
+_PII_FORBIDDEN_RE = re.compile(
+    r"cmdr_live_|[0-9a-f]{64}|[0-9]{11,14}|@[a-z0-9.-]+\.[a-z]{2,}",
+    re.IGNORECASE,
+)
+
