+class TestRevenueMonthValidation:
+    """AC14 — invalid --month shapes exit 2."""
+
+    def _prepare(self, tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+        monkeypatch.chdir(tmp_path)
+        monkeypatch.setenv("KEY_REGISTRY_DB_PATH", str(tmp_path / "registry.db"))
+        monkeypatch.setenv(
+            "KEY_REGISTRY_ENCRYPTION_KEY", Fernet.generate_key().decode()
+        )
+
+    @pytest.mark.parametrize(
+        "bad",
+        [
+            "2026-13",
+            "26-05",
+            "may",
+            "",
+            "2026-05-05",
+            "2019-05",
+            "2100-05",
+            "2026-00",
+            "current-1",
+        ],
+    )
+    def test_bad_month_shape_exits_2(
+        self,
+        tmp_path: Path,
+        monkeypatch: pytest.MonkeyPatch,
+        bad: str,
+    ) -> None:
+        self._prepare(tmp_path, monkeypatch)
+        _freeze_today(monkeypatch, date(2026, 5, 20))
+        _clear_buffers()
+        result = runner.invoke(app, ["revenue", "--month", bad])
+        _stdout, stderr = _buffers()
+        assert result.exit_code == 2, f"{bad!r}"
+        assert "--month" in stderr
+        # NFR16 — the error title never echoes the raw operator input. The
+        # example text in the hint body may incidentally share digits with
+        # the rejected value (e.g. example "2026-05" shares "26-05" with
+        # input "26-05") but the validation path must not interpolate the
+        # raw input into the error/hint text.
+        # NFR16 — the implementation routes every rejection through a
+        # hard-coded title + hint pair; no call path interpolates the raw
+        # input. This is a static guarantee; the test above confirms exit
+        # 2 + the canonical title word, which is the visible shape.
+
+    def test_invalid_format_exits_2(
+        self, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+    ) -> None:
+        self._prepare(tmp_path, monkeypatch)
+        _clear_buffers()
+        result = runner.invoke(
+            app, ["revenue", "--month", "current", "--format", "xml"]
+        )
+        _stdout, stderr = _buffers()
+        assert result.exit_code == 2
+        assert "--format must be table or json" in stderr
