+def _reset_consoles_to_buffers() -> Iterator[tuple[StringIO, StringIO]]:
+    stdout_buf = StringIO()
+    stderr_buf = StringIO()
+    output_mod._reset_for_tests()
+    output_mod._stdout_console = Console(
