+"""Story 4.4 — multi-replica safety regression for ``get_connection`` (FR44, NFR29).
+
+Comadre 2.0 lets operators scale ``deploy.replicas`` in ``compose.yaml``.
+Every replica opens its own SQLite connection against the same registry
+file under WAL mode. These tests pin the contract that the connection
+helper sustains concurrent reads + a single writer without
+``SQLITE_BUSY``, that WAL mode is set on every fresh connection, and
+that the parent directory + DB file land on mode ``0700`` / ``0600`` per
+``_chmod_0600`` + ``mkdir(mode=0o700)``.
+
+The within-process two-connection scenario is sufficient for the WAL
+contract (SQLite's WAL semantics are symmetric across the process
+boundary). True cross-process scaling is exercised in Task 8 of the
+story spec via ``compose.yaml``'s ``deploy.replicas``.
+"""
+
+from __future__ import annotations
+
+import stat
+from pathlib import Path
+
+from comadre.keys.db import (
+    _apply_migrations,
+    generate_customer_id,
+    get_connection,
+)
+
+
+def _now() -> str:
+    return "2026-04-20T12:00:00Z"
+
+
+def test_two_connections_can_concurrently_read_and_write(tmp_path: Path) -> None:
+    """FR44 + NFR29 — shared SQLite + WAL allows concurrent ops."""
+    db_path = tmp_path / "registry.db"
+    conn_a = get_connection(db_path)
+    conn_b = get_connection(db_path)
+    try:
+        _apply_migrations(conn_a)
+
+        version_via_b = conn_b.execute(
+            "SELECT MAX(version) FROM schema_version"
+        ).fetchone()[0]
+        assert version_via_b == 1
+
+        cid = generate_customer_id()
+        with conn_a:
+            conn_a.execute(
+                "INSERT INTO customer ("
+                "id, name, email, tax_id_kind, tax_id_encrypted, notes, "
+                "registered_at, deleted_at"
+                ") VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+                (
+                    cid,
+                    "Replica A",
+                    "a@example.com",
+                    "cpf",
+                    b"\x00",
+                    "",
+                    _now(),
+                    None,
+                ),
+            )
+
+        rows_via_b = conn_b.execute(
+            "SELECT name FROM customer WHERE id = ?", (cid,)
+        ).fetchall()
+        assert [r["name"] for r in rows_via_b] == ["Replica A"]
+
+        # B writes too; A reads back its row. Confirms either side can
+        # act as the single writer at any given moment under WAL.
+        cid_b = generate_customer_id()
+        with conn_b:
+            conn_b.execute(
+                "INSERT INTO customer ("
+                "id, name, email, tax_id_kind, tax_id_encrypted, notes, "
+                "registered_at, deleted_at"
+                ") VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+                (
+                    cid_b,
+                    "Replica B",
+                    "b@example.com",
+                    "cpf",
+                    b"\x00",
+                    "",
+                    _now(),
+                    None,
+                ),
+            )
+        rows_via_a = conn_a.execute(
+            "SELECT name FROM customer WHERE id = ?", (cid_b,)
+        ).fetchall()
+        assert [r["name"] for r in rows_via_a] == ["Replica B"]
+
+        assert stat.S_IMODE(db_path.stat().st_mode) == 0o600
+    finally:
+        conn_a.close()
+        conn_b.close()
+
+
+def test_journal_mode_is_wal_on_every_get_connection(tmp_path: Path) -> None:
+    """Every fresh connection independently sets WAL mode at open."""
+    db_path = tmp_path / "registry.db"
+    for _ in range(3):
+        conn = get_connection(db_path)
+        try:
+            mode = conn.execute("PRAGMA journal_mode").fetchone()[0]
+            assert mode.lower() == "wal"
+        finally:
+            conn.close()
+
+
+def test_parent_directory_is_0700_after_first_connection(tmp_path: Path) -> None:
+    """FR42 / NFR13 — parent dir mode + DB file mode enforced at open."""
+    db_path = tmp_path / "subdir" / "registry.db"
+    assert not db_path.parent.exists()  # mkdir is part of the contract
+    conn = get_connection(db_path)
+    try:
+        parent_mode = stat.S_IMODE(db_path.parent.stat().st_mode)
+        assert parent_mode == 0o700
+        db_mode = stat.S_IMODE(db_path.stat().st_mode)
+        assert db_mode == 0o600
+    finally:
+        conn.close()
