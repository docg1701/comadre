+          'chmod 600 /var/lib/comadre/registry.db
+          /var/lib/comadre/registry.db-wal
+          /var/lib/comadre/registry.db-shm 2>/dev/null; true'
+      changed_when: false
+
+    - name: "[FS] Enforce 0700 on registry parent directory"
+      ansible.builtin.command:
+        cmd: docker compose -f ~/comadre/compose.yaml exec -T tts-service chmod 700 /var/lib/comadre
+      changed_when: false
+
