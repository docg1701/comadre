+    # =========================================================================
+    # File-Permission Enforcement (Story 4.4 — FR42, NFR13)
+    # =========================================================================
+    # Belt-and-braces on top of src/comadre/keys/db.py::_chmod_0600 +
+    # get_connection's parent.mkdir(mode=0o700). The Python connection
+    # layer already enforces these modes on every connection open; the
+    # tasks below make bootstrap.yml self-evidently FR42 / NFR13
+    # fulfilling without requiring the reader to inspect Python.
+    # Idempotent: chmod is a no-op when the mode already matches.
+    # The shell-out goes through ``docker compose exec`` because the
+    # registry path lives in a named Docker volume — host-side
+    # ``ansible.builtin.file:`` cannot reach it without docker-engine
+    # internals.
+
+    - name: "[FS] Wait for service lifespan to materialise registry.db"
+      ansible.builtin.command:
+        cmd: docker compose -f ~/comadre/compose.yaml exec -T tts-service test -f /var/lib/comadre/registry.db
+      register: db_present
+      retries: 30
+      delay: 2
+      until: db_present.rc == 0
+      changed_when: false
+
+    - name: "[FS] Enforce 0600 on registry.db (and WAL/SHM sidecars)"
+      ansible.builtin.command:
