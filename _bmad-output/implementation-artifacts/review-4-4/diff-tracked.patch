+def _check_backup_cron_marker(marker_path: Path) -> HealthCheck:
+    """Backup-cron marker — written by ``bootstrap.yml`` at install time.
+
+    Marker format (Story 4.3 §3.4):
+      schedule=<cron-expression>
+      cron_tz=<IANA-timezone>
+      retention_days=<int>
+
+    Mirrors ``_check_cron_marker`` exactly; the only differences are the
+    label, the corrective hint, and the rendered value (which includes
+    ``retention_days`` because operators reading the report need the
+    archive-retention horizon alongside the schedule and TZ).
+    """
+    if not marker_path.exists():
+        return HealthCheck(
+            label="Backup cron",
+            value="Not installed",
+            severity="warn",
+            detail="run ansible-playbook bootstrap.yml",
+            data={"installed": False},
+        )
+    try:
+        text = marker_path.read_text(encoding="utf-8")
+    except (OSError, UnicodeDecodeError):
+        return HealthCheck(
+            label="Backup cron",
+            value="Marker present but unparseable",
+            severity="warn",
+            detail="re-run ansible-playbook bootstrap.yml",
+            data={"installed": True, "parsed": False},
+        )
+    parsed = _marker_parse(text)
+    if parsed is None:
+        return HealthCheck(
+            label="Backup cron",
+            value="Marker present but unparseable",
+            severity="warn",
+            detail="re-run ansible-playbook bootstrap.yml",
+            data={"installed": True, "parsed": False},
+        )
+    schedule = parsed.get("schedule", "").strip()
+    cron_tz = parsed.get("cron_tz", "").strip()
+    retention = parsed.get("retention_days", "").strip()
+    if not schedule or not cron_tz or not retention:
+        return HealthCheck(
+            label="Backup cron",
+            value="Marker present but unparseable",
+            severity="warn",
+            detail="re-run ansible-playbook bootstrap.yml",
+            data={"installed": True, "parsed": False},
+        )
+    value = (
+        f"comadre-keys-backup at {schedule} (CRON_TZ={cron_tz}, retention={retention}d)"
+    )
+    return HealthCheck(
+        label="Backup cron",
+        value=value,
+        severity="ok",
+        detail=None,
+        data={
+            "installed": True,
+            "schedule": schedule,
+            "tz": cron_tz,
+            "retention_days": retention,
+        },
+    )
+
