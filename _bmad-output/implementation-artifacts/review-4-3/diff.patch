index 0000000..a3001cd
--- /dev/null
+++ b/home/galvani/dev/comadre/deploy/ansible/playbooks/backup-keys.yml
@@ -0,0 +1,191 @@
+---
+# Comadre Key-Registry Backup Playbook (Story 4.3 — FR40, NFR14, NFR22)
+#
+# Creates a nightly-consistent encrypted snapshot of the SQLite key registry
+# + its Fernet encryption key, writes it to the DB's parent directory, and
+# prunes archives older than ``backup_retention_days`` (default 14).
+#
+#   export COMADRE_BACKUP_PASSPHRASE="$(python -c \
+#     'import secrets; print(secrets.token_urlsafe(32))')"
+#   ansible-playbook playbooks/backup-keys.yml -i inventory/production.yml \
+#     -e "ansible_become_password=YOUR_SUDO_PASS"
+#
+# The ``ansible_become_password`` is accepted for consistency with the other
+# playbooks in the suite but NOT strictly required — no task in this file
+# uses ``become: true``. All writes land inside the ``comadre-registry``
+# named volume as the unprivileged ``appuser`` inside the tts-service
+# container.
+#
+# Archive naming is load-bearing:
+#   ``{KEY_REGISTRY_DB_PATH}.backup-<UTC-ISO>.tar.gz.enc`` at mode 0600.
+# The path + glob are reserved for ``keys/health.py::_check_last_backup``
+# (pattern ``*.backup-*.tar.gz.enc`` rooted at ``Path(db_path).parent``).
+# Renaming silently breaks the "Last backup" health row — don't.
+#
+# Idempotency: running twice back-to-back produces two separate archives
+# (different ISO timestamp). The playbook's contract is "create a fresh
+# archive"; re-running is re-snapshotting, not a no-op.
+
+- name: Backup Comadre key registry
+  hosts: comadre_vps
+  gather_facts: false
+
+  tasks:
+    # =========================================================================
+    # Prerequisites
+    # =========================================================================
+
+    - name: "[Prereq] Verify SSH connectivity"
+      ansible.builtin.ping:
+
+    - name: "[Prereq] Validate backup passphrase is configured"
+      ansible.builtin.assert:
+        that:
+          - backup_passphrase | default('') | length >= 16
+        fail_msg: >-
+          COMADRE_BACKUP_PASSPHRASE environment variable is not set or is
+          shorter than 16 characters. Generate a fresh passphrase with:
+          export COMADRE_BACKUP_PASSPHRASE="$(python -c 'import secrets;
+          print(secrets.token_urlsafe(32))')"
+        success_msg: "Backup passphrase is configured ({{ backup_passphrase | length }} chars)."
+
+    - name: "[Prereq] Verify ~/comadre exists"
+      ansible.builtin.stat:
+        path: "~/comadre"
+      register: comadre_dir_stat
+
+    - name: "[Prereq] Fail if ~/comadre is missing"
+      ansible.builtin.assert:
+        that:
+          - comadre_dir_stat.stat.exists
+          - comadre_dir_stat.stat.isdir
+        fail_msg: >-
+          ~/comadre directory not found. Run bootstrap.yml before attempting
+          a backup.
+
+    - name: "[Prereq] Verify tts-service container is running"
+      ansible.builtin.command:
+        cmd: docker compose ps -q tts-service
+        chdir: "~/comadre"
+      register: tts_service_ps
+      changed_when: false
+      failed_when: tts_service_ps.stdout | length == 0
+
+    # =========================================================================
+    # Backup Execution
+    # =========================================================================
+    #
+    # Runs a single ``bash -c`` inside the tts-service container. The script:
+    #   1. Opens a SQLite consistency snapshot via Python stdlib Connection.backup().
+    #      This is NOT a plain ``cp`` — it follows SQLite's .backup() semantics,
+    #      serialising the DB without holding readers out and producing a
+    #      transactionally-consistent file even while the registry is being
+    #      written to.
+    #   2. Captures the live ``KEY_REGISTRY_ENCRYPTION_KEY`` from the process
+    #      env (source of truth — any .env edit since ``docker compose up`` has
+    #      NOT taken effect inside the running container until restart).
+    #   3. Tars both payloads (``registry.db``, ``encryption-key.txt``).
+    #   4. Encrypts the tarball with ``openssl enc -aes-256-cbc -pbkdf2
+    #      -salt -pass env:BACKUP_PASSPHRASE``. OpenSSL-3 default iter count
+    #      is 10 000 (PBKDF2-HMAC-SHA256) — adequate with a 32-char
+    #      urlsafe-base64 passphrase (256 bits entropy).
+    #   5. ``chmod 0600`` on the resulting archive (NFR14).
+    #   6. Prunes archives older than ``backup_retention_days`` via
+    #      ``find -mtime +N -delete`` in the same parent directory.
+
+    - name: "[Backup] Snapshot + encrypt + prune"
+      ansible.builtin.command:
+        cmd: >-
+          docker compose exec -T
+          -e BACKUP_RETENTION_DAYS={{ backup_retention_days | default(14) }}
+          tts-service
+          bash -c '{{ _backup_script }}'
+        chdir: "~/comadre"
+      vars:
+        _backup_script: |
+          set -euo pipefail
+          umask 077
+          DB_PATH="${KEY_REGISTRY_DB_PATH:-/var/lib/comadre/registry.db}"
+          DB_DIR="$(dirname "$DB_PATH")"
+          TS="$(date -u +%Y-%m-%dT%H-%M-%SZ)"
+          STAGING="$(mktemp -d -t comadre-backup.XXXXXX)"
+          trap "rm -rf \"$STAGING\"" EXIT
+          python -c "
+          import sqlite3, sys
+          src = sqlite3.connect(sys.argv[1])
+          dst = sqlite3.connect(sys.argv[2])
+          with dst:
+              src.backup(dst)
+          src.close()
+          dst.close()
+          " "$DB_PATH" "$STAGING/registry.db"
+          printf "%s" "$KEY_REGISTRY_ENCRYPTION_KEY" > "$STAGING/encryption-key.txt"
+          chmod 0600 "$STAGING/encryption-key.txt"
+          tar -C "$STAGING" -czf "$STAGING/bundle.tar.gz" registry.db encryption-key.txt
+          ARCHIVE="$DB_DIR/registry.db.backup-$TS.tar.gz.enc"
+          openssl enc -aes-256-cbc -pbkdf2 -salt \
+            -in "$STAGING/bundle.tar.gz" \
+            -out "$ARCHIVE" \
+            -pass env:BACKUP_PASSPHRASE
+          chmod 0600 "$ARCHIVE"
+          find "$DB_DIR" -maxdepth 1 -type f \
+            -name "registry.db.backup-*.tar.gz.enc" \
+            -mtime +"$BACKUP_RETENTION_DAYS" -print -delete
+          BYTES="$(stat -c '%s' "$ARCHIVE")"
+          echo "comadre-backup OK archive=$ARCHIVE bytes=$BYTES"
+      register: backup_result
+      changed_when: true
+
+    # =========================================================================
+    # Verification
+    # =========================================================================
+
+    - name: "[Verify] List the newest archive"
+      ansible.builtin.command:
+        cmd: >-
+          docker compose exec -T tts-service bash -c '
+          DB_DIR="$(dirname "${KEY_REGISTRY_DB_PATH:-/var/lib/comadre/registry.db}")";
+          ls -t "$DB_DIR"/registry.db.backup-*.tar.gz.enc 2>/dev/null | head -1'
+        chdir: "~/comadre"
+      register: newest_archive
+      changed_when: false
+
+    - name: "[Verify] Fail if no archive was produced"
+      ansible.builtin.assert:
+        that:
+          - newest_archive.stdout | trim | length > 0
+        fail_msg: "No backup archive found in the DB parent directory."
+
+    - name: "[Verify] Confirm archive is mode 0600"
+      ansible.builtin.command:
+        cmd: >-
+          docker compose exec -T tts-service bash -c 'stat -c %a "{{ newest_archive.stdout | trim }}"'
+        chdir: "~/comadre"
+      register: archive_mode
+      changed_when: false
+      failed_when: archive_mode.stdout | trim != "600"
+
+    # =========================================================================
+    # Summary
+    # =========================================================================
+
+    - name: "[Summary] Report backup status"
+      ansible.builtin.debug:
+        msg: |
+          ============================================
+          Comadre Key-Registry Backup — Complete
+          ============================================
+
+          Archive:        {{ newest_archive.stdout | trim }}
+          File mode:      {{ archive_mode.stdout | trim }}
+          Retention:      {{ backup_retention_days | default(14) }} days
+          Next cron run:  02:00 {{ billing_timezone | default('UTC') }}
+
+          Script output:
+          {{ backup_result.stdout | default('(none)') }}
+
+          Off-VPS archival hint — rotate this file to cold storage weekly:
+            scp {{ ansible_user }}@{{ ansible_host }}:{{ newest_archive.stdout | trim }} \
+              ./backups/
+
+          ============================================
diff --git a/home/galvani/dev/comadre/deploy/ansible/playbooks/restore-keys.yml b/home/galvani/dev/comadre/deploy/ansible/playbooks/restore-keys.yml
