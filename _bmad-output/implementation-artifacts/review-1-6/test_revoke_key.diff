+        assert after["status"] == "active"
+
+    def test_interactive_prompt_lives_on_stderr(self, env: dict[str, str]) -> None:
+        _cid, _kid = _seed_customer_and_key(env["db_path"])
+        _clear_buffers()
+        # Auto-abort so the prompt text is all we capture.
+        result = runner.invoke(
+            app,
+            ["revoke-key", "Pq_abc12", "--reason", "x"],
+            input="\n",
+        )
+        # Typer/Click writes the prompt to result.output which contains the
+        # merged stderr (because Click's confirm uses err=True). Our stdout
+        # buffer must NOT carry the prompt text — so `| tee` scripting is
+        # safe.
+        stdout, _stderr = _buffers()
+        assert "This will permanently revoke key" not in stdout
+        # And of course the command aborted cleanly.
+        assert result.exit_code == 2
