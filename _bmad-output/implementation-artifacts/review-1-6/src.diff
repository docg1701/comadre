+def _truncate_ident(raw: str) -> str:
+    """Return ``raw`` or its first-80-char-plus-ellipsis truncation.
+
+    Closes the Story 1.2 deferred-work item "Raw ``--customer`` string
+    interpolated into error title with no length cap" for every command
+    that echoes the operator's positional argument. A multi-KB paste
+    would otherwise blow up the red ErrorDisplay panel title.
+    """
+    if len(raw) <= _KEY_IDENT_ECHO_MAX:
+        return raw
+    return raw[:_KEY_IDENT_ECHO_MAX] + "\u2026"
+
+
+def _redact_log_target(raw: str) -> str:
+    """Redact a pasted ``cmdr_live_<plaintext>`` target for structured logs.
+
+    Matches the Story 1.4 ``show`` precedent: when the operator pastes the
+    full 53-char plaintext, the log line carries only the ``cmdr_live_`` tag
+    plus the first 8 characters of the suffix followed by an ellipsis. The
+    stored audit row and the ConfirmationLine / KeyPanel never see the
+    pasted value — the key_id resolved from the DB is used instead.
+    """
+    if raw.startswith("cmdr_live_"):
+        return "cmdr_live_" + raw.removeprefix("cmdr_live_")[:8] + "\u2026"
+    return raw
+
 
