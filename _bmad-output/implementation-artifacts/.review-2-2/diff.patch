diff --git a/src/comadre/rate_limit.py b/src/comadre/rate_limit.py
index ae8efad..e14b7ab 100644
--- a/src/comadre/rate_limit.py
+++ b/src/comadre/rate_limit.py
@@ -1,4 +1,17 @@
-"""Rate limiting via slowapi, X-Forwarded-For aware."""
+"""Rate limiting via slowapi, X-Forwarded-For aware.
+
+Story 2.2 layers dynamic per-key bucket resolution on top of the 1.6.2
+per-IP default. ``/v1/audio/speech`` overrides ``key_func`` via the
+endpoint decorator to route authenticated registry-mode requests to a
+per-key bucket; all other endpoints keep the module-level per-IP default.
+
+slowapi 0.1.9's limit-provider callable receives either ``()`` or
+``(key)`` — never the raw ``Request``. To let the dynamic resolver read
+the per-key rate limit, ``get_rate_limit_key`` embeds the limit string
+after a ``|`` separator in the bucket key, and ``resolve_speech_rate_limit``
+splits it back out. Tests and any direct call path can still invoke
+the resolver with a ``Request`` — the helper dispatches on argument type.
+"""
 
 from __future__ import annotations
 
@@ -23,4 +36,54 @@ def get_client_ip(request: Request) -> str:
     return "127.0.0.1"
 
 
+def get_rate_limit_key(request: Request) -> str:
+    """Return the rate-limit bucket key for ``request``.
+
+    Registry-mode authenticated requests bucket on the stable key ID
+    (``key:<key_id>``). Everything else — legacy mode, pre-auth
+    failures, slowapi's pre-handler probe — falls back to a namespaced
+    client IP (``ip:<ip>``). The ``key:`` / ``ip:`` namespacing keeps
+    a key_id that happens to equal a raw IP from colliding buckets.
+
+    The per-request limit string is appended after a ``|`` separator so
+    the sibling ``resolve_speech_rate_limit`` can recover it without
+    access to the request object (slowapi 0.1.9 does not pass the
+    request to the limit-provider callable).
+    """
+    payload = getattr(request.state, "auth_payload", None)
+    if payload is not None:
+        return f"key:{payload.key_id}|{payload.rate_limit_rpm}/minute"
+    ip = get_client_ip(request)
+    fallback: str = request.app.state.settings.rate_limit_speech
+    return f"ip:{ip}|{fallback}"
+
+
+def resolve_speech_rate_limit(key: Request | str) -> str:
+    """Return the per-request limit string for ``/v1/audio/speech``.
+
+    Registry-mode authenticated requests use the key's ``rate_limit_rpm``
+    (``f"{rpm}/minute"``). Legacy mode and the defensive fallback use
+    ``settings.rate_limit_speech`` (1.6.2 behaviour).
+
+    Called on two paths:
+
+    * slowapi dispatch — parameter named ``key`` so slowapi passes the
+      output of ``get_rate_limit_key(request)``; the limit string is
+      stripped off the trailing ``|`` segment.
+    * direct call — unit tests and any future caller pass a ``Request``;
+      the helper reads ``request.state.auth_payload`` directly and
+      falls back to ``request.app.state.settings.rate_limit_speech``.
+
+    Reads settings via ``request.app.state.settings`` on the direct path
+    to avoid the LRU-cached ``get_settings()`` on every request (NFR7).
+    """
+    if isinstance(key, Request):
+        payload = getattr(key.state, "auth_payload", None)
+        if payload is not None:
+            return f"{payload.rate_limit_rpm}/minute"
+        limit: str = key.app.state.settings.rate_limit_speech
+        return limit
+    return key.rsplit("|", 1)[1]
+
+
 limiter = Limiter(key_func=get_client_ip)
