+    async def test_resolve_and_keyfunc_called_once_per_request(
+        self,
+        app_monetized: Any,
+        client_monetized: AsyncClient,
+        monkeypatch: pytest.MonkeyPatch,
+    ) -> None:
+        """AC14: each resolver is invoked O(1) times per request (NFR7)."""
+        import comadre.rate_limit as rate_limit_module
+
+        resolve_calls = 0
+        keyfunc_calls = 0
+        real_resolve = rate_limit_module.resolve_speech_rate_limit
+        real_keyfunc = rate_limit_module.get_rate_limit_key
+
+        def _resolve_wrapper(key: Any) -> str:
+            nonlocal resolve_calls
+            resolve_calls += 1
+            return real_resolve(key)
+
+        def _keyfunc_wrapper(request: Any) -> str:
+            nonlocal keyfunc_calls
+            keyfunc_calls += 1
+            return real_keyfunc(request)
+
+        # Rebuild app with the patched callables in the decorator closure.
+        # Simpler: patch the module attributes and reload the route decorator
+        # via api.py — but the route is already decorated. Instead, monkeypatch
+        # on the decorator's captured references. slowapi stores the callables
+        # in LimitGroup objects; access via app.state.limiter._dynamic_route_limits.
+        limiter = app_monetized.state.limiter
+        for _name, groups in limiter._dynamic_route_limits.items():
+            for group in groups:
+                # LimitGroup stores the provider as a name-mangled attribute.
+                object.__setattr__(
+                    group, "_LimitGroup__limit_provider", _resolve_wrapper
+                )
+                group.key_function = _keyfunc_wrapper
+
+        plaintext, _kid, _cid = seed_customer_and_key(
+            app_monetized.state.registry_db, rate_limit_rpm=60
+        )
+        response = await client_monetized.post(
+            "/v1/audio/speech",
+            json=_SPEECH_BODY,
+            headers={"Authorization": f"Bearer {plaintext}"},
+        )
+        assert response.status_code == 200
+
+        # Each resolver called exactly twice per request (slowapi's flow
+        # evaluates key_func both in LimitGroup.__iter__ for dispatch and
+        # in __evaluate_limits for the bucket key; the limit-provider is
+        # called once per Limit). The invariant this guards is "bounded
+        # O(1) per request", not "exactly one".
+        assert 1 <= resolve_calls <= 2, resolve_calls
+        assert 1 <= keyfunc_calls <= 2, keyfunc_calls
+
