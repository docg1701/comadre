+
+            # Every api_key row gone.
+            remaining = conn.execute(
+                "SELECT COUNT(*) FROM api_key WHERE customer_id = ?",
+                (cid,),
+            ).fetchone()[0]
+            assert remaining == 0
+
+            # One new delete_customer audit row; no PII in details.
+            audit = self._audit_rows_for(conn, cid)
