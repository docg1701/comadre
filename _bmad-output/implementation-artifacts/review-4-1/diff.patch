+class TestFormatTaxIdDisplay:
+    """Story 4.1 — canonical → formatted CPF / CNPJ for LGPD export."""
+
+    def test_cpf_eleven_digits(self) -> None:
+        assert format_tax_id_display("12345678909", "cpf") == "123.456.789-09"
