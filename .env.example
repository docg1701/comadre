# Comadre — Environment Configuration
# Copy to .env and fill in values.

# Fernet key for encrypting tax IDs at rest in the key registry (REQUIRED).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_REGISTRY_ENCRYPTION_KEY=

# SQLite key registry path. Must match the in-container path used by both the
# tts-service container and the comadre-keys CLI (when run against the same
# mount). Compose bind-mounts the comadre-registry named volume at
# /var/lib/comadre, so the default below keeps the CLI and the service pointed
# at the same file.
KEY_REGISTRY_DB_PATH=/var/lib/comadre/registry.db

# Passphrase for AES-256-GCM encryption of the nightly backup tarball.
# Consumed by deploy/ansible/playbooks/backup-keys.yml + restore-keys.yml only;
# the FastAPI app and comadre-keys CLI never read it. Must be >= 16 chars when
# set; empty is accepted at boot so a fresh deployment can start before the
# bootstrap playbook runs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKUP_PASSPHRASE=

# IANA timezone for billing-day calculations and the daily suspension sweep's
# day-boundary. MUST match the cron CRON_TZ installed by bootstrap.yml — drift
# silently shifts the app's "today" relative to the cron schedule. Default UTC
# for operator-neutral predictability; override (e.g. America/Sao_Paulo) only
# when you've contractually informed customers that paid_until expires in that
# specific zone.
BILLING_TIMEZONE=UTC

# Operator contact string shown in CLI error hints (e.g. your ops email).
OPERATOR_CONTACT_HINT=

# Default voice for TTS when none specified (format: pocket/<name>).
DEFAULT_VOICE=pocket/rafael

# Domain for HTTPS (Caddy auto-provisions Let's Encrypt cert).
# Use "localhost" for a self-signed cert on private networks.
DOMAIN=localhost

# ---------------------------------------------------------------------------
# pocket-tts single engine (v3) — the only TTS engine.
# ---------------------------------------------------------------------------

# Language variant: portuguese (default) or portuguese_24l (larger model,
# deploy-time choice — one variant per replica).
POCKET_LANGUAGE=portuguese

# CPU threads for torch inference (applied after the pocket_tts import; the
# upstream library pins torch to 1 thread).
POCKET_THREADS=4

# int8 quantization (torchao) — reduces memory ~48%, usually faster on x86;
# optional. Phase 0 spike on a 12-core host measured +26% RTF on the
# distilled model — tune per host.
POCKET_QUANTIZE=false

# Generation temperature (the pocket-tts default).
POCKET_TEMPERATURE=0.7

# Sigla pronunciation lever: true = expand_siglas spaced letters
# (CNPJ -> C N P J) before generation.
POCKET_SIGLA_SPACING=true

# HuggingFace token for the ONE-TIME first-boot model download (the weights
# live in the gated kyutai/pocket-tts repo — accept the terms at
# https://huggingface.co/kyutai/pocket-tts first).
# bootstrap.yml hardens this automatically: after a healthy first boot it
# blanks HF_TOKEN and sets HF_HUB_OFFLINE=1, then restarts the service.
HF_TOKEN=
HF_HUB_OFFLINE=0

# ---------------------------------------------------------------------------
# Voice cloning (v3) — upload quotas and TTLs.
# ---------------------------------------------------------------------------

# Maximum upload size in MB for voice-clone audio files.
VOICE_UPLOAD_MAX_MB=10

# Reference-audio duration bounds in seconds (advertise 5-20 s; the library
# truncates at 30 s).
VOICE_REF_MIN_SECONDS=3
VOICE_REF_MAX_SECONDS=30

# Ephemeral clones (session voices): idle TTL, absolute TTL, per-key cap,
# and the global LRU cap across all keys.
VOICE_EPHEMERAL_IDLE_TTL_SECONDS=3600
VOICE_EPHEMERAL_ABSOLUTE_TTL_SECONDS=86400
VOICE_EPHEMERAL_MAX_PER_KEY=5
VOICE_EPHEMERAL_GLOBAL_MAX=50

# Stored (persisted) clones per customer.
VOICE_STORED_MAX_PER_CUSTOMER=20
