{
	default_sni {$DOMAIN:localhost}

	# Server header stripping: -Server and -Via are set in the site-level
	# ``header {}`` block below and via ``header_down`` in the reverse_proxy
	# handler. The ``servers { header ... }`` subdirective is NOT valid in
	# Caddy v2 (header is a site-level directive, not a server option).
	# See https://caddyserver.com/docs/caddyfile/options#server-options
}

{$DOMAIN:localhost} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "microphone=(), camera=(), geolocation=()"
		Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; connect-src 'self'; media-src 'self' blob:; upgrade-insecure-requests; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
		-Via
	}

	# CONNECT method → 405 (pentest F1). Caddy's default CONNECT handler
	# returns 200 OK even though no tunnel is established. This explicit
	# handler short-circuits before any other routing.
	@connect_method method CONNECT
	handle @connect_method {
		header Content-Type "application/json"
		respond `{"error":{"message":"CONNECT method not allowed","type":"invalid_request_error","hint":null,"status":405}}` 405
	}

	# Host header validation (pentest R2-2, R2-3). Only the configured
	# domain (or localhost fallback) is accepted. Unmatched Host headers
	# receive 421 Misdirected Request, which prevents the HTTP→HTTPS
	# redirect from reflecting attacker-supplied hostnames.
	@valid_host host {$DOMAIN:localhost}
	handle @valid_host {

	# FR49 — bounded-payload policy for the @api surface (/v1/* and /health).
	# Mirrors the industry-standard pattern used by AWS API Gateway,
	# Cloudflare, and nginx's `client_max_body_size`: every API request MUST
	# send a canonical Content-Length within the 1 MiB limit. Chunked
	# transfers, missing Content-Length on write methods, and malformed
	# Content-Length values are all rejected BEFORE reverse_proxy runs, so no
	# oversized or malformed body ever reaches the upstream. Handle blocks
	# are first-match-wins in Caddyfile order — keep the order below.
	#
	# Background: `request_body { max_size 1MiB }` paired with `reverse_proxy`
	# silently truncates oversized bodies and forwards the prefix to upstream
	# (empirically verified 2026-04-24 on caddy:2-alpine v2.11.2). That
	# anti-pattern is eliminated here by rejecting every way a >1 MiB body
	# could be sent at matcher time, before any reverse_proxy handler runs.
	# `request_body` is therefore not needed and has been removed.

	# B21 — every bounded-payload `respond` below ships the canonical
	# ComadreError-shaped JSON envelope with `Content-Type: application/json`
	# so the response is indistinguishable from app-level validation errors.
	# `error` (which would defer to `handle_errors`) was tried but Caddy
	# emits `text/plain` bodies for `error` even with `handle_errors` set,
	# so each matcher owns its envelope inline. The site-level header block
	# above re-applies HSTS / CSP / X-CT-O / X-Frame-Options on top.

	# 1. Any Transfer-Encoding header on @api → 411 (force Content-Length).
	# This API rejects ALL Transfer-Encoding values (chunked, gzip, identity,
	# non-canonical extension tokens). The four-clause policy assumes every
	# legitimate request is Content-Length-framed; stray TE values reach
	# reverse_proxy with ambiguous framing otherwise (RFC-7230 §3.3.3).
	# Mirrors AWS API Gateway / Cloudflare — neither accepts arbitrary TE.
	@api_has_te {
		path /v1/* /health
		header Transfer-Encoding *
	}
	handle @api_has_te {
		header Content-Type "application/json"
		respond `{"error":{"message":"Transfer-Encoding not permitted on /v1/* and /health; send Content-Length","type":"invalid_request_error","hint":"Use Content-Length framing for /v1/* and /health requests."}}` 411
	}

	# 2. Content-Length header present but not a canonical non-negative
	# integer of 1-10 digits → 400. Guards the @api_oversized_body CEL
	# `int()` cast against duplicate, negative, non-numeric, or overflow
	# values that would otherwise error the expression and fall through to
	# reverse_proxy. The 10-digit cap (max ~9.9 GB) is far above any
	# legitimate @api payload (1 MiB limit) but bounded well under int64
	# so the int() cast is always safe.
	@api_malformed_cl {
		path /v1/* /health
		header Content-Length *
		expression `!{http.request.header.content-length}.matches('^[0-9]{1,10}$')`
	}
	handle @api_malformed_cl {
		header Content-Type "application/json"
		respond `{"error":{"message":"Malformed Content-Length header","type":"invalid_request_error","hint":"Send a single non-negative integer Content-Length within 1-10 digits."}}` 400
	}

	# 3. Valid Content-Length > 1 MiB → 413, EXCEPT POST /v1/voices:
	# voice-clone uploads carry up to VOICE_UPLOAD_MAX_MB=10 MiB of audio
	# plus multipart form overhead — capped at 11 MiB. If VOICE_UPLOAD_MAX_MB
	# is raised beyond 10, raise the 11534336 (11 MiB) threshold here too.
	@api_oversized_body {
		path /v1/* /health
		not path /v1/voices
		header Content-Length *
		expression `{http.request.header.content-length}.matches('^[0-9]{1,10}$') && int({http.request.header.content-length}) > 1048576`
	}
	handle @api_oversized_body {
		header Content-Type "application/json"
		respond `{"error":{"message":"Payload too large","type":"invalid_request_error","hint":"Maximum request body size for /v1/* and /health is 1 MiB."}}` 413
	}

	# 3b. Valid Content-Length > 11 MiB on the clone-upload path → 413.
	@api_voices_oversized_body {
		path /v1/voices
		header Content-Length *
		expression `{http.request.header.content-length}.matches('^[0-9]{1,10}$') && int({http.request.header.content-length}) > 11534336`
	}
	handle @api_voices_oversized_body {
		header Content-Type "application/json"
		respond `{"error":{"message":"Payload too large","type":"invalid_request_error","hint":"Maximum request body size for POST /v1/voices is 11 MiB (VOICE_UPLOAD_MAX_MB + multipart overhead)."}}` 413
	}

	# 4. Write method (POST/PUT/PATCH) with neither Content-Length nor
	# Transfer-Encoding → 411. Prevents ambiguous zero-length writes that
	# would otherwise be proxied opaquely.
	@api_missing_cl {
		path /v1/* /health
		method POST PUT PATCH
		not header Content-Length *
		not header Transfer-Encoding *
	}
	handle @api_missing_cl {
		header Content-Type "application/json"
		respond `{"error":{"message":"Content-Length header is required","type":"invalid_request_error","hint":"Use Content-Length framing for POST/PUT/PATCH requests on /v1/* and /health."}}` 411
	}

	# 5. API paths → tts-service (reverse proxy).
	# No trusted_proxies — Caddy uses the direct client IP for X-Forwarded-For.
	# This prevents XFF spoofing (pentest R2-1) and ensures per-IP rate-limit
	# buckets key on real client IPs.
	@api path /v1/* /health
	handle @api {
		reverse_proxy {
			dynamic a {
				name tts-service
				port 8000
				refresh 5s
			}
			lb_policy least_conn
			header_down -server
			header_down -via
		}
	}

	# Everything else → static landing page
	handle {
		root * /srv/www
		file_server
	}

	}  # close @valid_host handle block

	# Unmatched Host → 421 Misdirected Request (pentest R2-2, R2-3).
	handle {
		header Content-Type "application/json"
		respond `{"error":{"message":"Invalid Host header","type":"invalid_request_error","hint":null,"status":421}}` 421
	}

	# F67 — re-apply the security headers + Server/Via strip on Caddy-level
	# error responses (404 from file_server, 405 from method_not_allowed,
	# 411/413/etc. from the @api respond blocks above). Without this,
	# Caddy's internal error path bypasses the site-level `header { ... }`
	# middleware and ships error responses with the bare `Server: Caddy`
	# banner and no security headers — empirically reproduced on
	# caddy:2-alpine v2.11.2 in 2026-04-21 review work for Story 4.5a.
	#
	# F70 — also rewrites the body to the project's ComadreError-shaped
	# JSON envelope so Caddy-level errors are indistinguishable from
	# upstream-level errors at the API contract layer.
	handle_errors {
		header {
			Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "microphone=(), camera=(), geolocation=()"
			Content-Security-Policy "default-src 'none'; upgrade-insecure-requests; frame-ancestors 'none'"
			Content-Type "application/json"
			-Server
			-Via
		}
		# B19 — match upstream ComadreError ``error_type`` shapes per status
		# class so JSON consumers don't need a special "is this from Caddy
		# or from the app?" branch. ``not_found_error`` for 404 mirrors the
		# FastAPI ``VoiceNotFoundError`` envelope; ``invalid_request_error``
		# for 4xx-other and ``server_error`` for 5xx mirror the generic
		# ComadreError taxonomy. The 404 case is the operator-visible one
		# (``/docs`` disabled in production hits this path).
		@cerr_404 expression {err.status_code} == 404
		handle @cerr_404 {
			respond `{"error":{"message":"{err.status_text}","type":"not_found_error","hint":null,"status":{err.status_code}}}` {err.status_code}
		}
		@cerr_405 expression {err.status_code} == 405
		handle @cerr_405 {
			respond `{"error":{"message":"{err.status_text}","type":"invalid_request_error","hint":null,"status":{err.status_code}}}` {err.status_code}
		}
		@cerr_4xx expression {err.status_code} >= 400 && {err.status_code} < 500
		handle @cerr_4xx {
			respond `{"error":{"message":"{err.status_text}","type":"invalid_request_error","hint":null,"status":{err.status_code}}}` {err.status_code}
		}
		@cerr_5xx expression {err.status_code} >= 500
		handle @cerr_5xx {
			respond `{"error":{"message":"{err.status_text}","type":"server_error","hint":null,"status":{err.status_code}}}` {err.status_code}
		}
		respond `{"error":{"message":"{err.status_text}","type":"server_error","hint":null,"status":{err.status_code}}}` {err.status_code}
	}

	log {
		output stdout
		format json
	}
}
