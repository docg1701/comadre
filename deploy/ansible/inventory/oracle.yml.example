all:
  hosts:
    comadre_vps:
      # Oracle Cloud Ampere A1 (Always Free Tier) — aarch64 host
      ansible_host: "CHANGE_ME"        # IP or DNS of the Oracle VM
      ansible_user: "ubuntu"
      ansible_ssh_private_key_file: "~/.ssh/CHANGE_ME.key"
      ansible_ssh_common_args: "-o ForwardAgent=yes"

  vars:
    # Fernet key used to encrypt tax IDs at rest in the key registry (REQUIRED).
    # Reads from COMADRE_KEY_REGISTRY_ENCRYPTION_KEY env var. Generate with:
    #   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
    # In production, store inside an ansible-vault file rather than plain env.
    key_registry_encryption_key: "{{ lookup('env', 'COMADRE_KEY_REGISTRY_ENCRYPTION_KEY') }}"

    # Operator contact string shown in CLI error messages (e.g. your ops email).
    operator_contact_hint: ""

    # Optional: local directory containing kokoro/ subdir with voice files
    voices_local_dir: "{{ playbook_dir }}/../../../voices"

    # Git repository URL and branch to clone on the VM
    repo_url: "git@github.com:docg1701/comadre.git"
    repo_branch: "master"

    # Default voice for TTS when none specified
    default_voice: "kokoro/pm_santa"

    # Real domain → Caddy provisions Let's Encrypt cert via ACME HTTP-01
    domain: "CHANGE_ME.duckdns.org"

    # Public landing page (true is the default — Oracle hosts are public-facing
    # so the showcase page makes sense here)
    landing_enabled: true

    # Daily restart hour (0-23)
    restart_hour: 3

    # Kokoro model download URLs (auto-download on first startup)
    kokoro_model_url: "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.onnx"
    kokoro_voices_url: "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin"

    # Qwen3 disabled — the prebuilt qwen3-tts-cli binary is x86_64-only
    # and cannot run on aarch64. Kokoro covers ~99% of real workload anyway.
    qwen3_enabled: false
    qwen3_model_url: ""
    qwen3_tokenizer_url: ""

    # Not used when qwen3_enabled is false
    qwen3_model_local: ""
    qwen3_tokenizer_local: ""
