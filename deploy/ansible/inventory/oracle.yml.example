all:
  hosts:
    comadre_vps:
      # Oracle Cloud Ampere A1 (Always Free Tier) — aarch64 host
      ansible_host: "CHANGE_ME"        # IP or DNS of the Oracle VM
      ansible_user: "ubuntu"
      ansible_ssh_private_key_file: "~/.ssh/CHANGE_ME.key"

  vars:
    # Fernet key used to encrypt tax IDs at rest in the key registry (REQUIRED).
    # Reads from COMADRE_KEY_REGISTRY_ENCRYPTION_KEY env var. Generate with:
    #   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
    # In production, store inside an ansible-vault file rather than plain env.
    key_registry_encryption_key: "{{ lookup('env', 'COMADRE_KEY_REGISTRY_ENCRYPTION_KEY') }}"

    # Passphrase for AES-256 encryption of the nightly backup tarball (REQUIRED).
    # Reads from COMADRE_BACKUP_PASSPHRASE env var. Must be >= 16 chars; use
    # 32+ for production. Store alongside KEY_REGISTRY_ENCRYPTION_KEY in your
    # password manager — losing it means the backup tarballs are unreadable.
    # Generate with:
    #   python -c "import secrets; print(secrets.token_urlsafe(32))"
    backup_passphrase: "{{ lookup('env', 'COMADRE_BACKUP_PASSPHRASE') }}"

    # Number of days to retain .tar.gz.enc backup archives in the registry
    # volume before the nightly sweep deletes them. The backup cron runs at
    # 02:00 operator TZ, so a 14-day retention gives ~14 nightly snapshots
    # before rotation. Increase to 30+ for more forensic history; decrease
    # to 7 to cap disk footprint.
    backup_retention_days: 14

    # Hour (0-23) the nightly backup cron fires in ``billing_timezone``. Default
    # 02:00 leaves a comfortable 90-minute gap after the midnight suspension
    # sweep (00:30) so the snapshot reflects the day's suspensions and runs
    # well clear of any peak-hour traffic.
    backup_hour: 2

    # In-container path of the SQLite key registry. Single source of truth
    # consumed by bootstrap.yml, health.yml, and ``compose.yaml`` (the latter
    # via ``${KEY_REGISTRY_DB_PATH:-...}`` substitution). Marker files
    # (``.cron-installed`` / ``.backup-cron-installed``) and the parent-dir
    # chmod derive from this value via Jinja's ``| dirname`` filter, so any
    # override must keep the path at least two components deep
    # (``/x/y/registry.db``) — the ``[Prereq] Validate key_registry_db_path``
    # assert in ``bootstrap.yml`` enforces this.
    key_registry_db_path: /var/lib/comadre/registry.db

    # Operator contact string shown in CLI error messages (e.g. your ops email).
    operator_contact_hint: ""

    # Optional: local directory containing a pocket/ subdir with voice files
    voices_local_dir: "{{ playbook_dir }}/../../../voices"

    # Git repository URL and branch to clone on the VM
    repo_url: "git@github.com:docg1701/comadre.git"
    repo_branch: "master"

    # Path to SSH deploy key generated on VPS for GitHub access
    deploy_key_path: "/home/{{ ansible_user }}/.ssh/comadre_deploy"

    # GitHub repository path as "owner/repo" — used to construct the API URL
    # for deploy key registration
    github_repo_path: "docg1701/comadre"

    # GitHub Personal Access Token (classic) with 'repo' scope.
    # Used ONCE at bootstrap to register the deploy key via API. After
    # registration the PAT can expire with zero impact.
    # Encrypt with:
    #   ansible-vault encrypt_string "ghp_YOUR_TOKEN" --name github_pat
    # Then copy the output (!vault | ...) and replace the block below.
    # Also create a vault password file:
    #   echo -n "your_vault_password" > deploy/ansible/.vault_pass && chmod 600 deploy/ansible/.vault_pass
    github_pat: !vault |
              $ANSIBLE_VAULT;1.1;AES256
              CHANGE_ME

    # Default voice for TTS when none specified (format: pocket/<name>)
    default_voice: "pocket/rafael"

    # Real domain → Caddy provisions Let's Encrypt cert via ACME HTTP-01
    domain: "CHANGE_ME.duckdns.org"

    # Public landing page (true is the default — Oracle hosts are public-facing
    # so the showcase page makes sense here)
    landing_enabled: true

    # IANA timezone the daily suspension sweep (00:30 local) runs in. MUST match
    # the BILLING_TIMEZONE env var in .env — drift between the two silently
    # shifts the sweep's "today" computation relative to the cron schedule.
    #
    # Default UTC for operator-neutral, internationally predictable billing.
    # Override to a local zone (e.g. "America/Sao_Paulo") only when you have
    # contractually informed customers that their paid_until day-turnover is
    # interpreted in that specific zone — changing this value after customers
    # are onboarded shifts when their keys flip to 401 on the billing day.
    billing_timezone: "UTC"

    # pocket-tts (v3) — the only engine, CPU-only, runs on aarch64.
    pocket_language: "portuguese"
    pocket_threads: 4
    pocket_quantize: false
    pocket_temperature: 0.7

    # HF token for the one-time first-boot model download (gated weights).
    pocket_hf_token: "{{ lookup('env', 'HF_TOKEN') | default('') }}"

    # Air-gapped deploy path (deploy-models.yml); empty = auto-download.
    pocket_model_local: ""
    pocket_tokenizer_local: ""
    pocket_rafael_local: ""
