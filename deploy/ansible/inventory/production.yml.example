all:
  hosts:
    comadre_vps:
      # VPS connection — set these to your server's IP and SSH user
      ansible_host: "CHANGE_ME"
      ansible_user: "CHANGE_ME"
      ansible_ssh_common_args: "-o ForwardAgent=yes"

  vars:
    # Fernet key used to encrypt tax IDs at rest in the key registry (REQUIRED).
    # Reads from COMADRE_KEY_REGISTRY_ENCRYPTION_KEY env var. Generate with:
    #   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
    # In production, store inside an ansible-vault file rather than plain env.
    key_registry_encryption_key: "{{ lookup('env', 'COMADRE_KEY_REGISTRY_ENCRYPTION_KEY') }}"

    # Operator contact string shown in CLI error messages (e.g. your ops email).
    operator_contact_hint: ""

    # Optional: local directory containing kokoro/ and qwen/ subdirs with voice files
    # Used by deploy-voices.yml playbook. Leave empty to skip voice deployment.
    # See docs/voice-management.md for directory structure.
    voices_local_dir: ""

    # Git repository URL and branch to clone on the VPS
    repo_url: "CHANGE_ME"
    repo_branch: "master"

    # Default voice for TTS when none specified (format: engine/name)
    default_voice: "kokoro/pm_santa"

    # Domain for HTTPS (Caddy auto-provisions Let's Encrypt cert)
    # Use "localhost" for self-signed cert on private networks
    domain: "localhost"

    # Public landing page at https://<domain>/ — when true (default), Caddy
    # serves a self-contained HTML form at the root path that lets anyone
    # with a valid API key try Comadre from a browser. Set to false on
    # internal/private deployments where you don't want a public face;
    # the API endpoints under /v1/* and /health are always served either way.
    landing_enabled: true

    # Daily restart hour (0-23) — precaution against potential memory leaks
    restart_hour: 3

    # IANA timezone the daily suspension sweep (00:30 local) runs in. MUST match
    # the BILLING_TIMEZONE env var in .env — drift between the two silently
    # shifts the sweep's "today" computation relative to the cron schedule.
    #
    # Default UTC for operator-neutral, internationally predictable billing.
    # Override to a local zone (e.g. "America/Sao_Paulo") only when you have
    # contractually informed customers that their paid_until day-turnover is
    # interpreted in that specific zone — changing this value after customers
    # are onboarded shifts when their keys flip to 401 on the billing day.
    billing_timezone: "UTC"

    # Kokoro model download URLs (auto-download on first startup)
    kokoro_model_url: "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.onnx"
    kokoro_voices_url: "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin"

    # Enable Qwen3 engine. Set to false on hosts where the x86_64 binary
    # cannot run (e.g. aarch64 / Oracle Cloud Ampere A1). When false, Qwen3
    # model download, load, and warm-up are skipped at startup.
    qwen3_enabled: true

    # Qwen3 GGUF model download URLs (auto-download on first startup)
    qwen3_model_url: "https://huggingface.co/PabloHoties/Qwen3-TTS-12Hz-0.6B-Base-GGUF/resolve/main/qwen3-tts-0.6b-q8_0.gguf"
    qwen3_tokenizer_url: "https://huggingface.co/PabloHoties/Qwen3-TTS-12Hz-0.6B-Base-GGUF/resolve/main/qwen3-tts-tokenizer-f16.gguf"

    # Optional: local paths to pre-converted Qwen3 GGUF model files
    # If set, deploy-models.yml copies these to the VPS instead of downloading
    qwen3_model_local: ""
    qwen3_tokenizer_local: ""
